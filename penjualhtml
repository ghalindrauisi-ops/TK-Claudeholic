<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Portal Mitra Penjual – KantinUI</title>
  <!-- <link rel="stylesheet" href="style.css"> jangan lupa hapus di tiap html mau ganti ke tailwind  -->
  <script src="https://cdn.tailwindcss.com"></script> 
</head>
<body>
  <script>
    // Buka otomatis tampilan Portal Penjual saat file ini dibuka langsung
    window.addEventListener("DOMContentLoaded", () => {
      if (typeof window.bukaPortalPenjual === "function") {
        window.bukaPortalPenjual();
      }
    });
  </script>
  <div id="portal-redirect-container"></div>
  <script>
    // Memuat struktur utama dari index.html jika diakses mandiri
    fetch("index.html")
      .then(r => r.text())
      .then(html => {
        const doc = new DOMParser().parseFromString(html, "text/html");
        document.body.innerHTML = doc.body.innerHTML;
        const s = document.createElement("script");
        s.src = "script.js";
        s.onload = () => { if (window.bukaPortalPenjual) window.bukaPortalPenjual(); };
        document.body.appendChild(s);
      });
  </script>
</body>
</html>

